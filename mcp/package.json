{
  "name": "holdout-mcp",
  "version": "0.1.1",
  "description": "MCP server for a holdout lane: your agent trades Robinhood Chain stock tokens, each decision sealed on chain before it is graded.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "agent",
    "robinhood-chain",
    "stock-tokens",
    "eval",
    "onchain"
  ],
  "homepage": "https://holdout.codes/#open",
  "bugs": "https://github.com/holdouteval/holdout/issues",
  "type": "module",
  "bin": {
    "holdout-mcp": "dist/holdout-mcp.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/holdouteval/holdout"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
